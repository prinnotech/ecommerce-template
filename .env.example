# Public site URL (canonical links, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PocketBase. Locally: npm run pb (http://127.0.0.1:8090).
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Read by PocketBase itself (pb_hooks/app-url.pb.js): the storefront URL used in auth emails.
PB_APP_URL=http://localhost:3000

# PocketBase superuser. Used by BOTH services: PocketBase creates it on the first start
# (pb_migrations/1793059208_bootstrap_admins.js) and Next.js signs in with it on the server.
# Never prefix with NEXT_PUBLIC_. Password: at least 10 characters.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# Read by PocketBase: the store owner's dashboard account, created on the first start.
# Password: at least 8 characters. Change it after the first sign-in (My account → Profile).
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD=

# Optional: Slack incoming webhook for reportError().
SLACK_ERROR_WEBHOOK=
