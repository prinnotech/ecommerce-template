# Copy to .env.local (root: scripts) and to apps/store/.env.local and apps/admin/.env.local.

# Public URL of the STORE (canonical links, emails, the admin's "View store" link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public URL of the ADMIN app (staff invite links).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Which backend: supabase | sqlite | pocketbase. Default: pocketbase.
BACKEND=pocketbase

# ---------- Supabase (BACKEND=supabase) — setup steps in docs/supabase.md ----------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key: sessions and sign-in. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: admin auth calls and image storage. Server only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Connect → "Transaction pooler"). Server only.
DATABASE_URL=
# "true" if your plan has image transformations (resized thumbnails).
SUPABASE_IMAGE_TRANSFORMS=false

# ---------- SQLite (BACKEND=sqlite) — docs/sqlite.md ----------
# Defaults: data/store.db and data/uploads at the repo root. Store and admin must share them.
SQLITE_PATH=
UPLOADS_DIR=
# Password-reset emails through Resend. Without them the reset link is written to the server log.
RESEND_API_KEY=
EMAIL_FROM=

# ---------- PocketBase (BACKEND=pocketbase). Locally: npm run pb ----------
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Read by PocketBase itself (pb_hooks/app-url.pb.js): the storefront URL used in auth emails.
PB_APP_URL=http://localhost:3000

# PocketBase superuser. Used by BOTH services: PocketBase creates it on the first start
# (pb_migrations/1793059208_bootstrap_admins.js) and Next.js signs in with it on the server.
# Never prefix with NEXT_PUBLIC_. Password: at least 10 characters.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# ---------- Store owner (all backends) ----------
# The owner's dashboard account: created on PocketBase's first start, or by npm run db:setup.
# Password: at least 8 characters. Change it after the first sign-in.
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD=

# ---------- Themes (admin → Online store → Themes) ----------
# Server only, the SAME value in both apps (any random text, 16+ characters). Signs the theme
# editor's live-preview links and the admin's "refresh the store" request after a publish.
# Without it the editor works but shows no preview, and the store updates within 60 s.
THEME_PREVIEW_SECRET=

# ---------- Payments and email (admin → Settings → Payments / Email sending) ----------
# Encrypts the secrets typed in the admin (Stripe secret key, Stripe webhook secret, SMTP
# password) before they're stored. 16+ random characters, the SAME value in the admin and the
# store. Without it those fields can't be saved from the admin (use the env variables below).
SETTINGS_ENCRYPTION_KEY=
# Optional: set a secret here instead of in the admin (the env variable wins).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_PASSWORD=
# Store only: protects /api/cron/abandoned-checkouts (16+ random characters). Your host's cron
# calls it every 15-60 minutes with "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does it on
# its own). Without it the automatic abandoned-checkout email is off; the admin button still works.
CRON_SECRET=

# ---------- Domains (admin → Settings → Domains) — docs/domains.md ----------
# railway | vercel | empty = manual, for any other host (domains are recorded and DNS is checked, you attach them by hand).
HOSTING_PROVIDER=
# Server only, never NEXT_PUBLIC_. Railway: account or workspace token. Vercel: access token.
HOSTING_API_TOKEN=
# Manual mode: where each app's DNS should point: a hostname (my-store.onrender.com → CNAME) or a server IPv4 (→ A record).
HOSTING_STORE_TARGET_HOST=
HOSTING_ADMIN_TARGET_HOST=
# Railway (Project settings → General; each service's settings show its id)
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_STORE_SERVICE_ID=
RAILWAY_ADMIN_SERVICE_ID=
# Vercel (Project → Settings → General → Project ID; team id only for team projects)
VERCEL_TEAM_ID=
VERCEL_STORE_PROJECT_ID=
VERCEL_ADMIN_PROJECT_ID=

# Optional: Slack incoming webhook for reportError().
SLACK_ERROR_WEBHOOK=

# ---------- Public demo (optional) ----------
# "true" shows "Try the demo" on the admin login and seeds the demo with `npm run demo:seed`.
DEMO_MODE=
# The demo admin password (defaults to jkdvPfuPrpetttcS when unset).
DEMO_ADMIN_PASSWORD=
