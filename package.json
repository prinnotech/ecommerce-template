{
  "name": "storefront-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:store": "npm run dev -w @repo/store",
    "dev:admin": "npm run dev -w @repo/admin",
    "build": "npm run build -w @repo/store && npm run build -w @repo/admin",
    "build:store": "npm run build -w @repo/store",
    "build:admin": "npm run build -w @repo/admin",
    "start:store": "npm run start -w @repo/store",
    "start:admin": "npm run start -w @repo/admin",
    "lint": "eslint",
    "typecheck": "npm run typecheck -w @repo/store && npm run typecheck -w @repo/admin",
    "format": "prettier --write .",
    "pb": "node scripts/pocketbase.mjs",
    "db:setup": "node scripts/db-setup.mts",
    "typegen": "node scripts/typegen.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "seed": "node scripts/seed.mjs",
    "demo:seed": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo.mjs --reset",
    "import-products": "node scripts/import-products.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "kysely": "^0.29.7",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-i18n-router": "^5.5.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pocketbase": "^0.28.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.2",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
